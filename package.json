{
  "name": "urban-venture",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test:geo": "tsx --test src/lib/geo/*.test.ts scripts/etl/lib/*.test.ts src/lib/landiq/*.test.ts src/lib/news/*.test.ts",
    "etl:lgd": "tsx scripts/etl/load-lgd.ts",
    "etl:boundaries": "tsx scripts/etl/load-boundaries.ts",
    "eval:resolver": "tsx scripts/eval/run-resolver-eval.ts",
    "test:analytics": "tsx --env-file=.env.local --test src/lib/analytics/*.test.ts",
    "golden:import": "tsx scripts/eval/golden-set.ts --import",
    "golden:export": "tsx scripts/eval/golden-set.ts --export",
    "landiq:seed-weights": "tsx scripts/landiq/seed-weight-profiles.ts",
    "news:seed": "tsx scripts/news/seed-and-ingest.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@indic-transliteration/sanscript": "^1.3.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slider": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "double-metaphone": "^2.0.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-auth": "^4.24.14",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts && npx tsx prisma/seed-upgraded.ts"
  }
}
