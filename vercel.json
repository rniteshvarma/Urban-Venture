{
  "framework": "nextjs",
  "regions": [
    "hnd1"
  ],
  "buildCommand": "node scripts/copy-maplibre-worker.mjs && npx prisma db push && npx prisma generate && npx tsx scripts/reference/seed-corridors.ts && npx tsx scripts/inventory/seed-inventory.ts && next build",
  "crons": [
    {
      "path": "/api/cron/renew-gmail-watch",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/ingest-news",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/listings-daily",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/listings-weekly",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/cron/infra-crawl",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/cron/whatsapp-maintenance",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/osm-sync",
      "schedule": "0 22 * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/infra-crawl/route.ts": {
      "regions": [
        "bom1"
      ],
      "maxDuration": 300
    },
    "src/app/api/admin/infra-intel/runs/[id]/process/route.ts": {
      "regions": [
        "bom1"
      ],
      "maxDuration": 300
    },
    "src/app/api/cron/osm-sync/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/admin/osm/sync/route.ts": {
      "maxDuration": 300
    }
  }
}
